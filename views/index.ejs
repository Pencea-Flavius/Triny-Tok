    repo: { name: 'R.E.P.O.', bg: '/images/games/repo-hero.jpg', icon: `<svg width="24" height="24" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M50 6h.4q3.4 0 6.8.6l.9.1q3 .4 5.8 1.3h.3l1.4.5.5.2.9.3.3.1 3 1.3 3.1 1.5.5.2v.2l1.2.5.3.2.3.2.7.4v.2h.2l.9.5v.2h.2l1.3.8.2.2.3.2.2.2q.2 0 .3.4l.4.2.5.4.3.1.2.2v.2h.2l.5.4v.2h.2l.7.6.9.8 1.4 1.4.3.2q.8.8 1.4 1.7l.7.7a33 33 0 0 1 3.7 5l.4.7.7 1.2.6 1 1.5 3 1.4 3.2q0 .4.3.8l1 3.4q.4.9.5 1.8l.2.6c1.7 7.6 1.2 15.3 1.2 23.2H.8c0-16 0-16 .5-18.8v-1q.7-4 2-7.9l.1-.3.9-2.4 1.9-4.2.1-.2 2.8-4.8.2-.3h.2v-.2c.6-1.3 1.8-2.5 2.7-3.5l.8-1.1.2-.2h.2l.2-.4h.2v-.2l.7-.8.2-.1.3-.4.5-.5.4-.3.1-.1q.4-.5.6-.4l.2-.4h.2l.1-.3.4-.4 1.2-.9 1.9-1.5.3-.2.3-.3q.1 0 .3-.2l.5-.1.1-.3.4-.3 2.6-1.6q.4 0 .7-.3l.2-.2.4-.2.9-.3v-.2h.2l.7-.4.3-.1 2-1 3.7-1.4 1-.3.3-.1.6-.2A37 37 0 0 1 46 6.2h.6zM18.3 30.6l-.6.5-.7.6-.5.5-1 1.1-.1.3c-.6.7-.6.7-1 1.6l-.1.1c-1.3 1.4-1.8 3.9-2 5.6l-.2.5q-.5 3.6.7 7v.3a15 15 0 0 0 2.8 4.9h.2v.2l.8 1 2.5 2 .2.1Q21 58 23 58.7h.2c3.9 1.4 8.1 1 11.8-.7l2-1.1v-.2h.3v-.2h-.4q-1.2-.1-2.3-.7h-.2l-1-1-.2-.2q-1.1-1.2-1-3 0-2 1.3-3.4 1.8-1.5 4.1-1.3 1.6.3 2.8 1.4l.2.2a5 5 0 0 1 1.1 3.5q.4-.3.6-.8l.2-.4q.7-1.2 1-2.4l.2-.6q1-3 .6-5.9v-.2q-.3-3-1.8-5.8v-.2l-1.4-2-.4-.6a16 16 0 0 0-6.2-4.7l-.2-.1a14 14 0 0 0-5.5-1.2C25 27 21 28 18.3 30.5M71 27q-2 .1-4.1.8h-.2a12 12 0 0 0-3.3 1.7l-.5.2v.2h-.2l-.9.7-.2.1c-1.8 1.6-1.8 1.6-3.1 3.5v.2h-.2a16 16 0 0 0-1.5 14.7q.3 1 .9 1.8l.3.7h.2l.1.2v-.3q.2-2.2 1.7-3.7a5 5 0 0 1 3.8-1q1.2.1 2 .8l.2.1q1.3 1 1.7 2.5.5 2.1-.6 4a5 5 0 0 1-3.8 2.1l-.6.1c2.3 2.3 6.4 3 9.4 3.1q1 0 2.1-.2h.2l2.9-.8.3-.1a17 17 0 0 0 5-3.1q.6-.3.8-.8l.5-.5 1.4-1.8.2-.3q2.7-4.3 2.5-9.4v-.2q0-2.9-1.3-5.4l-.2-.5-1.1-2-.1-.2-.2-.3v-.2l-.2-.1h-.2v-.3l-.3-.3-.6-.7c-1-1-2-2-3.2-2.7h-.2v-.2Q76 26.9 71 27.1m0 0" /><path d="M.8 70.7h98.4v20.2H24.1l-.8-.1H13.1c-2.7 0-2.7 0-3.9-.2H7.6l-.8-.1-1.1-.1H4.4l-.9-.1H1.2l-.3.1-.1-.1zm0 0" /><path d="M60.2 47.7q0 .3-.2.5l-.1.2q-.2 0-.2.2l-.2.1-.2-.1q.4-.6.9-.9m0 0" /><path d="m34 47.7.2.1-.8.8-.2-.1zm0 0" /></svg>` },
    minecraft: { name: 'Minecraft', bg: '/images/games/minecraft-hero.jpg', icon: `<svg width="28" height="28" viewBox="0 0 20 20" fill="currentColor" fill-rule="evenodd" xmlns="http://www.w3.org/2000/svg"><path d="M12,10 L16,10 L16,6 L12,6 L12,10 Z M4,10 L8,10 L8,6 L4,6 L4,10 Z M18,18 L14,18 L14,12 L12,12 L12,10 L8,10 L8,12 L6,12 L6,18 L2,18 L2,2 L18,2 L18,18 Z M8,18 L12,18 L12,16 L8,16 L8,18 Z M0,20 L20,20 L20,0 L0,0 L0,20 Z" /></svg>` },
  };
  const eventTemplates = [
    { game: 'isaac', title: 'Total Chaos', desc: '5 items + 10 enemies + all curses at once', user: 'zzflaviusboss', repeat: 1 },
    { game: 'goi', title: 'Zero Gravity', desc: 'Gravity disabled for 60 seconds', user: 'alexnon3', repeat: 1 },
    { game: 'repo', title: 'Player Kill', desc: 'Instantly kills a random player', user: 'mihaicred', repeat: 1 },
    { game: 'isaac', title: 'Glitch Storm', desc: 'Spawns 3 TMTRAINER items', user: 'memenorul20', repeat: 1 },
    { game: 'minecraft', title: 'Kill Command', desc: 'Executes /kill on the server', user: 'gtrap_', repeat: 1 },
    { game: 'goi', title: 'Spawn Oranges', desc: 'Rains oranges on the player', user: 'andrei.umbra', repeat: 3 },
    { game: 'minecraft', title: 'Summoned Creeper', desc: 'A wild Creeper appears!', user: 'muttxx3', repeat: 1 }
  ];

  // Fetch gifts and demo users
  Promise.all([
    fetch('/api/gifts').then(r => r.json()),
    fetch('/api/demo-users').then(r => r.json())
  ])
  .then(([giftsData, usersData]) => {
    const gifts = (giftsData.gifts || []).filter(g => g.image?.url_list?.[0]);
    if (gifts.length === 0) return;

    // Target specific gifts by their IDs: Doughnut(5879), Perfume(5658), Romanian Polenta(6540), Super GG(12988), Rosa(8913), Gold Boxing Gloves(5853), Creeper(54724)
    const targetGiftIds = [5879, 5658, 6540, 12988, 8913, 5853, 54724];

    // Map the demo users
    const demoUsers = {};
    if (usersData.users) {
      usersData.users.forEach(u => demoUsers[u.uniqueId] = u);
    }

    demoEvents = eventTemplates.map((tpl, i) => {
      const targetId = targetGiftIds[i];
      let g = gifts.find(gift => gift.id === targetId);
      
      // Fallback to random/sorted if still not found
      if (!g) {
        const sorted = [...gifts].sort((a, b) => (a.diamond_count || 0) - (b.diamond_count || 0));
        g = sorted[Math.min(i * Math.floor(sorted.length / targetGiftIds.length), sorted.length - 1)] || gifts[0];
      }

      const dbUser = demoUsers[tpl.user];
      const fallbackPic = 'https://www.tiktok.com/static/images/avatar_default.png';

      return {
        ...tpl,
        giftName: g.name,
        giftIcon: g.image.url_list[0],
        diamonds: g.diamond_count || 1,
        msg: `sent ${g.name}`,
        // Use demo user data if exists
        demoNickname: dbUser ? (dbUser.nickname || dbUser.uniqueId) : tpl.user,
        demoAvatar:   (dbUser && dbUser.profilePictureUrl) ? dbUser.profilePictureUrl : fallbackPic
      };
      });

      // Preload images to prevent pop-in
      demoEvents.forEach(ev => {
      if (ev.demoAvatar) new Image().src = ev.demoAvatar;
      if (ev.giftIcon) new Image().src = ev.giftIcon;
      });

      applyDemo(demoEvents[0]);
      })
      .catch(err => console.error("Demo load failed:", err));

      let idx = 0;
      const eventBox = document.getElementById('demoEvent');
      const card = document.getElementById('demoCard');
      const itemBox = document.getElementById('demoDonationItem');
      const connBox = document.querySelector('.demo-connection');

      // The hero's picture follows the game on the card.
      const heroBgs = [document.getElementById('heroBgA'), document.getElementById('heroBgB')];
      let heroBgIdx = 0;
      function setHeroBg(url) {
        const next = heroBgs[1 - heroBgIdx];
        const img = new Image();
        img.onload = () => {
          next.style.backgroundImage = `url('${url}')`;
          next.style.opacity = '1';
          heroBgs[heroBgIdx].style.opacity = '0';
          heroBgIdx = 1 - heroBgIdx;
        };
        img.src = url;
      }

      function applyDemo(ev) {
      if (!ev) return;

      // Set text immediately while hidden
      const game = GAMES[ev.game];
      setHeroBg(game.bg);
      card.style.setProperty('--demo-accent', `var(--game-${ev.game})`);
      document.getElementById('demoGameIcon').innerHTML     = game.icon;
      document.getElementById('demoGame').textContent       = game.name;
      document.getElementById('demoTitle').textContent      = ev.title;
      document.getElementById('demoDesc').textContent       = ev.desc;

      document.getElementById('demoAvatar').src             = ev.demoAvatar || 'https://www.tiktok.com/static/images/avatar_default.png';
      document.getElementById('demoUser').textContent       = ev.demoNickname || ev.user;
      document.getElementById('demoMsg').textContent        = ev.msg;
      document.getElementById('demoGiftName').textContent   = ev.giftName || '';
      document.getElementById('demoGiftIcon').src           = ev.giftIcon || '';
      document.getElementById('demoRepeat').textContent     = 'x' + (ev.repeat || 1);

      const diamondSvg = '<svg width="12" height="12" viewBox="0 0 640 640" fill="currentColor"><path d="M232.5 136L320 229L407.5 136L232.5 136zM447.9 163.1L375.6 240L504.6 240L448 163.1zM497.9 288L142.1 288L320 484.3L497.9 288zM135.5 240L264.5 240L192.2 163.1L135.6 240zM569.8 280.1L337.8 536.1C333.3 541.1 326.8 544 320 544C313.2 544 306.8 541.1 302.2 536.1L70.2 280.1C62.5 271.6 61.9 258.9 68.7 249.7L180.7 97.7C185.2 91.6 192.4 87.9 200 87.9L440 87.9C447.6 87.9 454.8 91.5 459.3 97.7L571.3 249.7C578.1 258.9 577.4 271.6 569.8 280.1z"/></svg>';
      document.getElementById('demoDiamonds').innerHTML     = ((ev.diamonds || 0) * (ev.repeat || 1)).toLocaleString() + diamondSvg;

      itemBox.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';
      if (connBox) connBox.style.transition = 'opacity 0.3s ease-out';
      eventBox.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';

      // Give browser a moment to apply the new image src before fading in
      setTimeout(() => {
      // 1) Fade IN the donation
      itemBox.style.opacity = '1';
      itemBox.style.transform = 'none';

      // 2) Fade IN the connection line
      setTimeout(() => {
        if (connBox) connBox.style.opacity = '1';
      }, 300);

      // 3) Fade IN the in-game event to show causality
      setTimeout(() => {
        eventBox.style.opacity = '1';
        eventBox.style.transform = 'none';
      }, 600);
      }, 50);
      }
  function nextDemo() {
    if (demoEvents.length === 0) return;
    idx = (idx + 1) % demoEvents.length;
    const ev = demoEvents[idx];

    // Fade OUT all
    itemBox.style.opacity = '0';
    itemBox.style.transform = 'translateY(12px)';
    if (connBox) connBox.style.opacity = '0';
    eventBox.style.opacity = '0';
    eventBox.style.transform = 'translateY(12px)';
    
    // Wait for fade OUT to finish, then apply new demo
    setTimeout(() => {
      applyDemo(ev);
    }, 400);
  }

  // Pauses while someone is looking at it; never starts under reduced motion.
  let demoPaused = false;
  card.addEventListener('mouseenter', () => { demoPaused = true; });
  card.addEventListener('mouseleave', () => { demoPaused = false; });
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => { if (!demoPaused) nextDemo(); }, 4500);
  }

  // ── GAMES BACKGROUND HOVER CROSSFADE ──
  const gamesBgLayer = document.getElementById('gamesBgLayer');
  gamesBgLayer.style.opacity = '1';
  gamesBgLayer.style.backgroundImage = 'none';

  const bgWrapper = document.createElement('div');
  Object.assign(bgWrapper.style, { position: 'absolute', inset: '0', zIndex: '-1' });
  gamesBgLayer.appendChild(bgWrapper);

  const bgLayers = [document.createElement('div'), document.createElement('div')];
  let activeBgIdx = 0;

  bgLayers.forEach(layer => {
    Object.assign(layer.style, {
      position: 'absolute', inset: '0',
      backgroundSize: 'cover', backgroundPosition: 'center',
      opacity: '0', transition: 'opacity 0.45s ease'
    });
    bgWrapper.appendChild(layer);
  });

  document.querySelectorAll('.game-card').forEach(card => {
    card.addEventListener('mouseenter', () => {
      const bg = card.getAttribute('data-bg');
      if (bg) {
        activeBgIdx = 1 - activeBgIdx;
        bgLayers[activeBgIdx].style.backgroundImage = `url('${bg}')`;
        bgLayers[activeBgIdx].style.opacity = '0.35';
        bgLayers[1 - activeBgIdx].style.opacity = '0';
      }
    });
    card.addEventListener('mouseleave', () => {
      bgLayers[0].style.opacity = '0';
      bgLayers[1].style.opacity = '0';
    });
  });
</script>

<% if (!user) { %>
<!-- Guest modal -->
<dialog id="guestModal" class="guest-dialog" aria-labelledby="guestTitle">
  <div class="guest-body">
    <h2 class="guest-title" id="guestTitle">You're not signed in</h2>
    <p class="guest-text">You can still use TrinyTok without an account: your config is saved locally as a JSON file.</p>
    <p class="guest-text">With an account you also get <strong>saved presets</strong>: keep several named configurations and switch between them.</p>

    <div class="guest-actions">
      <a class="btn btn-lead guest-continue" href="/app">Continue without account</a>
      <a class="btn btn-ghost" href="/login">Sign in</a>
      <a class="btn btn-ghost" href="/register">Create account</a>
    </div>
  </div>
</dialog>
<script>
  const guestModal = document.getElementById('guestModal');
  function openGuestModal() { guestModal.showModal(); }
  guestModal.addEventListener('click', (e) => { if (e.target === guestModal) guestModal.close(); });
</script>
<% } %>
</body>
</html>
