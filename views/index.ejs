<!DOCTYPE html>
<html lang="en">
<head>
  <script>document.documentElement.classList.add('js');</script>
  <%- include('partials/head', { title: 'Donations that change your game' }) %>
  <link rel="stylesheet" href="/css/homepage.css">
</head>
<body>

<%- include('partials/nav') %>

<!-- HERO -->
<div class="hero-wrap crt">
  <div class="hero-bg" id="heroBgA"></div>
  <div class="hero-bg" id="heroBgB"></div>
<section class="hero">

  <div>
    <h1 class="hero-title">Your viewers change the game in real time</h1>
    <p class="hero-sub">Gifts from your TikTok Live trigger effects in the games you stream.</p>
    <div class="hero-actions">
        <a class="btn btn-lead" href="/app"<% if (!user) { %> onclick="openGuestModal(); return false;"<% } %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          Open App
        </a>
      <a class="btn btn-ghost" href="#how-it-works">How it works</a>
    </div>
  </div>

  <!-- DEMO CARD -->
  <div class="demo" id="demoCard">
    <div class="demo-head label">Example</div>

    <div class="demo-part" id="demoDonationItem">
      <div class="demo-user">
        <img class="demo-avatar" id="demoAvatar" src="https://www.tiktok.com/static/images/avatar_default.png" alt="" onerror="if (!this.src.includes('avatar_default')) this.src='https://www.tiktok.com/static/images/avatar_default.png';">
        <div>
          <div class="demo-username" id="demoUser">alex_gamer99</div>
          <div class="demo-msg" id="demoMsg">sent Rose</div>
        </div>
      </div>
      <div class="demo-gift">
        <img class="demo-gift-img" id="demoGiftIcon" src="/images/gifts/5655.png" alt="">
        <div>
          <div class="demo-gift-name" id="demoGiftName">Rose</div>
          <div class="demo-gift-meta">
            <span id="demoRepeat">x1</span>
            <span class="demo-diamonds" id="demoDiamonds">1 <svg width="12" height="12" viewBox="0 0 640 640" fill="currentColor"><path d="M232.5 136L320 229L407.5 136L232.5 136zM447.9 163.1L375.6 240L504.6 240L448 163.1zM497.9 288L142.1 288L320 484.3L497.9 288zM135.5 240L264.5 240L192.2 163.1L135.6 240zM569.8 280.1L337.8 536.1C333.3 541.1 326.8 544 320 544C313.2 544 306.8 541.1 302.2 536.1L70.2 280.1C62.5 271.6 61.9 258.9 68.7 249.7L180.7 97.7C185.2 91.6 192.4 87.9 200 87.9L440 87.9C447.6 87.9 454.8 91.5 459.3 97.7L571.3 249.7C578.1 258.9 577.4 271.6 569.8 280.1z"/></svg></span>
          </div>
        </div>
      </div>
    </div>

    <div class="demo-connection" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
    </div>

    <div class="demo-part demo-event" id="demoEvent">
      <div class="demo-game-icon" id="demoGameIcon"></div>
      <div>
        <div class="demo-game-name label" id="demoGame">Minecraft</div>
        <div class="demo-event-title" id="demoTitle">Summoned Creeper</div>
        <div class="demo-event-desc" id="demoDesc">A wild Creeper appears!</div>
      </div>
    </div>
  </div>

</section>
</div>

<!-- HOW IT WORKS -->
<section class="section reveal" id="how-it-works">
  <h2 class="section-title">From gift to in-game effect</h2>

  <ol class="steps">
    <li class="step">
      <span class="step-num">1</span>
      <h3 class="step-title">Connect</h3>
      <p class="step-desc">Run TrinyTok on your PC and enter your TikTok username.</p>
    </li>
    <li class="step">
      <span class="step-num">2</span>
      <h3 class="step-title">Map gifts</h3>
      <p class="step-desc">Choose which effect each gift triggers, per game.</p>
    </li>
    <li class="step">
      <span class="step-num">3</span>
      <h3 class="step-title">Go live</h3>
      <p class="step-desc">When a viewer sends that gift, the effect runs in your game.</p>
    </li>
  </ol>
</section>

<!-- GAMES -->
<div class="games-section reveal">
  <div class="games-bg-layer" id="gamesBgLayer"></div>
  <div class="games-inner">
    <h2 class="section-title">Supported games</h2>

    <div class="games-grid">

      <div class="game-card" style="--game: var(--game-minecraft);" data-bg="/images/games/minecraftbackground.png">
        <div class="game-thumb crt">
          <img src="/images/games/Minecraft.png" class="game-cover-img" alt="Minecraft cover" loading="lazy">
        </div>
        <div class="game-name">Minecraft</div>
        <div class="game-effect">Summoned Creeper</div>
      </div>

      <div class="game-card" style="--game: var(--game-isaac);" data-bg="/images/games/isaacbackground.jpg">
        <div class="game-thumb crt">
          <img src="/images/games/isaac.png" class="game-cover-img" alt="The Binding of Isaac cover" loading="lazy">
        </div>
        <div class="game-name">The Binding of Isaac</div>
        <div class="game-effect">Total Chaos</div>
      </div>

      <div class="game-card" style="--game: var(--game-repo);" data-bg="/images/games/repobackground.png">
        <div class="game-thumb crt">
          <img src="/images/games/repo.jpg" class="game-cover-img" alt="R.E.P.O. cover" loading="lazy">
        </div>
        <div class="game-name">R.E.P.O.</div>
        <div class="game-effect">Player Kill</div>
      </div>

      <div class="game-card" style="--game: var(--game-goi);" data-bg="/images/games/goibackground.jpg">
        <div class="game-thumb crt">
          <img src="/images/games/goi.png" class="game-cover-img" alt="Getting Over It cover" loading="lazy">
        </div>
        <div class="game-name">Getting Over It</div>
        <div class="game-effect">Zero Gravity</div>
      </div>

    </div>
  </div>
</div>

<!-- CTA -->
<section class="closing reveal">
  <div class="section">
    <h2 class="closing-title">Make your stream unpredictable</h2>
    <p class="closing-sub">Works without an account. Sign up only to save presets.</p>
  <a class="btn btn-lead" href="/app"<% if (!user) { %> onclick="openGuestModal(); return false;"<% } %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          Open App
        </a>
  </div>
</section>

<%- include('partials/footer') %>

