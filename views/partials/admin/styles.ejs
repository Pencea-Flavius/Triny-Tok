<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: var(--font); }

  .admin-layout { display: flex; min-height: 100vh; padding-top: 62px; }

  .admin-sidebar {
    width: 220px; flex-shrink: 0; padding: 28px 0;
    border-right: 1px solid var(--tint);
    position: sticky; top: 62px; height: calc(100vh - 62px);
    overflow-y: auto; background: var(--bg);
  }
  .sidebar-label { font-size: 12px; font-weight: 600; color: var(--muted); padding: 0 20px 10px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 20px; font-size: 13px; font-weight: 600;
    color: var(--muted); text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s; border-left: 2px solid transparent;
  }
  .sidebar-link:hover { color: var(--text); background: var(--tint); }
  .sidebar-link.active { color: var(--text); border-left-color: var(--accent); background: rgba(var(--accent-rgb),0.05); }
  .sidebar-link svg { flex-shrink: 0; }
  .sidebar-badge { margin-left: auto; font-size: 11px; font-weight: 800; background: var(--border2); border-radius: 4px; padding: 2px 7px; color: var(--muted); }
  .sidebar-link.active .sidebar-badge { background: rgba(var(--accent-rgb),0.15); color: var(--accent); }
  .sidebar-divider { height: 1px; background: var(--tint); margin: 12px 0; }

  .admin-main { flex: 1; min-width: 0; padding: 32px 40px 60px; }

  .page-heading { margin-bottom: 28px; }
  .page-eyebrow { font-size: 12px; font-weight: 600; color: var(--danger); margin-bottom: 6px; }
  .page-title { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }

  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 32px; }
  .stat-card { background: var(--tint); border: 1px solid var(--tint); border-radius: 4px; padding: 16px 18px; }
  .stat-label { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .stat-value { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; color: var(--text); }
  .stat-card.teal .stat-value { color: var(--accent); }
  .stat-card.danger .stat-value { color: var(--danger); }

  .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 18px; flex-wrap: wrap; }
  .search-input { flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--field-border); border-radius: 4px; padding: 9px 14px; font-size: 13px; color: var(--text); font-family: inherit; transition: border-color 0.15s; }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--dim); }
  .btn-search { padding: 9px 18px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; background: var(--accent); border: none; color: var(--on-accent); transition: background 0.15s; white-space: nowrap; }
  .btn-search:hover { background: var(--accent); }
  .btn-clear { padding: 9px 16px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; background: var(--tint); border: 1px solid var(--border2); color: var(--muted); text-decoration: none; white-space: nowrap; transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s; }
  .btn-clear:hover { color: var(--text); background: var(--border2); }

  .results-count { font-size: 12px; color: var(--muted); padding: 4px 0; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--tint); border-radius: 4px; }
  table { width: 100%; border-collapse: collapse; }
  thead th { font-size: 12px; font-weight: 600; color: var(--muted); padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--tint); white-space: nowrap; background: var(--tint); }
  thead th a { display: inline-flex; align-items: center; gap: 5px; color: inherit; text-decoration: none; transition: color 0.15s; }
  thead th a:hover { color: var(--text); }
  thead th.sort-active a { color: var(--accent); }
  .sort-icon { opacity: 0.4; }
  thead th.sort-active .sort-icon { opacity: 1; color: var(--accent); }
  tbody td { padding: 11px 16px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--tint); vertical-align: middle; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: var(--tint); }

  .gift-img { width: 30px; height: 30px; object-fit: contain; border-radius: 4px; }
  .mono { font-family: monospace; font-size: 11px; color: var(--muted); }
  .diamonds { color: var(--accent); font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
  .diamonds svg { flex-shrink: 0; }
  .badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 800; border-radius: 4px; padding: 3px 8px; }
  .badge-teal   { background: rgba(var(--accent-rgb),0.12); color: var(--accent); }
  .badge-dim    { background: var(--tint); color: var(--muted); }
  .badge-danger { background: rgba(var(--danger-rgb),0.12);  color: var(--danger); }
  .badge-green  { background: rgba(var(--success-rgb),0.12);  color: var(--success); }

  .action-group { display: flex; gap: 6px; justify-content: flex-end; }
  .btn-sm { display: inline-flex; align-items: center; min-height: 32px; gap: 5px; padding: 5px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s; white-space: nowrap; }
  .btn-danger-sm  { background: rgba(var(--danger-rgb),0.08);  border: 1px solid rgba(var(--danger-rgb),0.2);  color: var(--danger); }
  .btn-danger-sm:hover  { background: rgba(var(--danger-rgb),0.18);  border-color: var(--danger); }
  .btn-neutral-sm { background: var(--tint); border: 1px solid var(--border2); color: var(--muted); }
  .btn-neutral-sm:hover { background: var(--border2); color: var(--text); }
  .btn-lead-sm    { background: rgba(var(--accent-rgb),0.08);  border: 1px solid rgba(var(--accent-rgb),0.2);  color: var(--accent); }
  .btn-lead-sm:hover    { background: rgba(var(--accent-rgb),0.15);  border-color: var(--accent); }

  .alert { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 4px; font-size: 13px; font-weight: 600; margin-bottom: 20px; }
  .alert-success { background: rgba(var(--accent-rgb),0.07);  border: 1px solid rgba(var(--accent-rgb),0.2);  color: var(--accent); }
  .alert-error   { background: rgba(var(--danger-rgb),0.07);  border: 1px solid rgba(var(--danger-rgb),0.2);  color: var(--danger); }

  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .game-card { background: var(--tint); border: 1px solid var(--tint); border-radius: 4px; padding: 20px; }
  .game-card-title { font-size: 13px; font-weight: 800; margin-bottom: 4px; }
  .game-card-sub   { font-size: 12px; color: var(--muted); margin-bottom: 14px; }
  .game-card-count { font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: var(--text); }
  .game-card-label { font-size: 11px; color: var(--muted); margin-top: 2px; }

  .modal-overlay { position: fixed; inset: 0; z-index: 1000; background: var(--scrim); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal-box { background: var(--bg2); border: 1px solid rgba(var(--danger-rgb),0.2); border-radius: 4px; padding: 30px 26px 22px; max-width: 400px; width: 90%; transform: translateY(14px) scale(0.97); transition: transform 0.2s; }
  .modal-overlay.open .modal-box { transform: none; }
  .modal-icon { width: 44px; height: 44px; border-radius: 50%; background: rgba(var(--danger-rgb),0.1); border: 1px solid rgba(var(--danger-rgb),0.2); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--danger); }
  .modal-title { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
  .modal-desc  { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 22px; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
  .btn-modal-cancel  { padding: 9px 18px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s; background: var(--tint); border: 1px solid var(--border2); color: var(--muted); }
  .btn-modal-cancel:hover  { color: var(--text); background: var(--border2); }
  .btn-modal-confirm { padding: 9px 18px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s, opacity 0.15s, transform 0.15s; background: rgba(var(--danger-rgb),0.12); border: 1px solid rgba(var(--danger-rgb),0.3); color: var(--danger); }
  .btn-modal-confirm:hover { background: rgba(var(--danger-rgb),0.22); border-color: var(--danger); }

  .empty-state { text-align: center; padding: 48px 0; color: var(--muted); font-size: 13px; }

  @media (max-width: 800px) {
    .admin-layout { flex-direction: column; }
    .admin-sidebar { position: static; width: 100%; height: auto; padding: 16px 0; border-right: none; border-bottom: 1px solid var(--border); }
    .admin-main { padding: 24px 20px 48px; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
