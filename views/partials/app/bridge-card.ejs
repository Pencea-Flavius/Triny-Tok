<div class="card bridge-card" id="<%= game %>BridgeCard" data-state="off">
  <div>
    <div class="label">Bridge status</div>
    <div class="bridge-status">
      <span class="bridge-dot" id="<%= game %>StatusIndicator"></span>
      <span id="<%= game %>StatusTextLarge">Offline</span>
    </div>
  </div>
  <button class="btn-primary" id="<%= game %>ConnectBtn">
    <span id="<%= game %>BtnIcon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
    </span>
    <span id="<%= game %>BtnText">Start Bridge</span>
  </button>
</div>
