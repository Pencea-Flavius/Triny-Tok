<style>
  #aiGameSuggestContent { display: none; flex-direction: column; height: 100%; }
  #aiGameSuggestContent.active { display: flex; }

  .aig-layout { display: flex; flex-direction: column; flex: 1; gap: 16px; min-height: 0; }

  .aig-messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* The conversation keeps a readable, centred column on any screen. */
  .aig-msg,
  .aig-input-bar {
    width: 100%;
    max-width: 820px;
    margin-inline: auto;
  }

  .aig-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aig-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    max-width: 560px;
  }
  .aig-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    padding: 18px 16px;
    text-align: center;
    font-family: inherit;
    color: inherit;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .aig-chip:hover { border-color: var(--accent); }
  .aig-chip-label { font-size: 14px; font-weight: 600; }
  .aig-chip-sub { font-size: 13px; color: var(--muted); }

  .aig-msg { display: flex; flex-direction: column; gap: 4px; }
  .aig-msg-user { align-items: flex-end; }
  .aig-msg-ai { align-items: flex-start; }
  .aig-label { font-size: 12px; font-weight: 600; color: var(--muted); }

  .aig-bubble { max-width: 72ch; font-size: 14px; line-height: 1.6; }
  .aig-bubble-user { padding: 10px 14px; background: var(--accent-dim); border-radius: var(--r-md); }
  .aig-bubble-ai { white-space: pre-wrap; }
  .aig-bubble-error { color: var(--danger); }

  .aig-typing { padding: 4px 0; font-size: 14px; color: var(--muted); }

  .aig-input-bar { flex-shrink: 0; display: flex; gap: 8px; align-items: flex-end; }
  #aigInput {
    flex: 1;
    width: auto;
    resize: none;
    line-height: 1.5;
    max-height: 100px;
    overflow-y: auto;
  }
  .aig-send-btn { height: 46px; justify-content: center; flex-shrink: 0; }
  .aig-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .aig-send-btn.loading svg { animation: aig-spin 0.8s linear infinite; }
  @keyframes aig-spin { to { transform: rotate(360deg); } }
</style>

<div class="tab-content" id="aiGameSuggestContent">
  <% if (!user) { %>
  <div class="card empty-state">
    <p>You need to be logged in to use AI suggestions.</p>
    <a href="/login" class="btn-primary" style="text-decoration:none;">Sign in</a>
  </div>
  <% } else { %>

  <div class="aig-layout">

    <div class="page-header">
      <div>
        <h1 class="page-h1">What should I stream?</h1>
        <p class="page-sub">Tell me the vibe and I'll pick a game for your next stream.</p>
      </div>
      <button class="btn-secondary btn-sm" onclick="aigClear()">Clear</button>
    </div>

    <div class="aig-messages" id="aigMessages">
      <div class="aig-empty" id="aigEmpty">
        <div class="aig-chips">
          <button class="aig-chip" onclick="aigQuick('Something chill and relaxing')">
            <div class="aig-chip-label">Chill session</div>
          </button>
          <button class="aig-chip" onclick="aigQuick('Something where viewers can troll me')">
            <div class="aig-chip-label">Let viewers troll</div>
          </button>
          <button class="aig-chip" onclick="aigQuick('Most competitive game')">
            <div class="aig-chip-label">Competitive</div>
          </button>
          <button class="aig-chip" onclick="aigQuick('Something funny to watch')">
            <div class="aig-chip-label">Entertaining</div>
          </button>
        </div>
      </div>
    </div>

    <div class="aig-input-bar">
      <textarea id="aigInput" rows="1"
        placeholder="Ask what to stream..."
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();aigSend();}"
        oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,100)+'px'"></textarea>
      <button class="btn-primary aig-send-btn" id="aigSendBtn" aria-label="Send" onclick="aigSend()">
        <svg id="aigSendIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>

  </div>

  <% } %>
</div>

<% if (user) { %>
<script>
(function() {
  const MODEL_LABEL = 'AI';
  let isLoading = false;
  const EMPTY_HTML = document.getElementById('aigEmpty').outerHTML;

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function showEmpty(v) {
    const el = document.getElementById('aigEmpty');
    if (el) el.style.display = v ? 'flex' : 'none';
  }

  function scrollBottom() {
    const msgs = document.getElementById('aigMessages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  }

  function appendMsg(role, text, isError) {
    showEmpty(false);
    const msgs = document.getElementById('aigMessages');
    const wrap = document.createElement('div');
    wrap.className = 'aig-msg aig-msg-' + role;

    const label = document.createElement('div');
    label.className = 'aig-label';
    label.textContent = role === 'user' ? 'You' : MODEL_LABEL;

    const bubble = document.createElement('div');
    bubble.className = 'aig-bubble ' + (role === 'user' ? 'aig-bubble-user' : isError ? 'aig-bubble-error' : 'aig-bubble-ai');
    bubble.textContent = text;

    wrap.appendChild(label);
    wrap.appendChild(bubble);
    msgs.appendChild(wrap);
    scrollBottom();
    return wrap;
  }

  function addTyping() {
    showEmpty(false);
    const msgs = document.getElementById('aigMessages');
    const wrap = document.createElement('div');
    wrap.className = 'aig-msg aig-msg-ai';
    wrap.id = 'aigTyping';

    const label = document.createElement('div');
    label.className = 'aig-label';
    label.textContent = MODEL_LABEL;

    const t = document.createElement('div');
    t.className = 'aig-typing';
    t.textContent = 'Thinking...';

    wrap.appendChild(label);
    wrap.appendChild(t);
    msgs.appendChild(wrap);
    scrollBottom();
  }

  function removeTyping() {
    const t = document.getElementById('aigTyping');
    if (t) t.remove();
  }

  async function send(prompt) {
    if (isLoading || !prompt.trim()) return;
    isLoading = true;

    const btn = document.getElementById('aigSendBtn');
    btn.disabled = true;
    btn.classList.add('loading');

    appendMsg('user', prompt);
    addTyping();

    try {
      const res  = await fetch('/api/ai/game-suggestion?prompt=' + encodeURIComponent(prompt));
      const data = await res.json();
      removeTyping();
      if (data.success) {
        appendMsg('ai', data.suggestion || '(no response)', false);
      } else {
        appendMsg('ai', data.error || 'Something went wrong.', true);
      }
    } catch (err) {
      removeTyping();
      appendMsg('ai', 'Network error: ' + err.message, true);
    } finally {
      isLoading = false;
      btn.disabled = false;
      btn.classList.remove('loading');
    }
  }

  window.aigSend = function() {
    const input = document.getElementById('aigInput');
    const val = input.value.trim();
    if (!val) return;
    input.value = '';
    input.style.height = 'auto';
    send(val);
  };

  window.aigQuick = function(text) {
    send(text);
  };

  window.aigClear = function() {
    document.getElementById('aigMessages').innerHTML = EMPTY_HTML;
  };
})();
</script>
<% } %>
