<div id="isaacEffectsContent" class="tab-content">
  <div class="page-header">
    <div>
      <h1 class="page-h1">The Binding of Isaac</h1>
      <p class="page-sub">Gift effects. Choose what each TikTok gift does in the game.</p>
    </div>
    <div class="page-actions">
      <a href="/gift-overlay.html?game=isaac" target="_blank" class="btn-secondary btn-sm" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
        Overlay
      </a>
      <button class="btn-secondary btn-sm" id="isaacSetupBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Setup Guide
      </button>
      <button class="btn-secondary btn-accent btn-sm" id="addIsaacEffectBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Add Effect
      </button>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:16px;flex:1;min-height:0;">
    <%- include('./bridge-card', { game: 'isaac' }) %>

    <!-- Mapped Effects -->
    <div class="card" style="flex:1;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <div class="card-title">Mapped effects</div>
        <%- include('./preset-btn', { game: 'isaac', wrapperId: 'presetWrapIsaac' }) %>
      </div>
      <div class="table-wrap" style="margin:0;border:none;background:transparent;">
        <div class="data-table-container">
          <table class="data-table" style="table-layout:fixed;width:100%;">
            <thead>
              <tr>
                <th style="width:200px;">TikTok gift</th>
                <th>Effect</th>
                <th style="width:280px;text-align:center;">Actions</th>
              </tr>
            </thead>
            <tbody id="isaacEffectsTableBody">
              <tr><td colspan="3" style="text-align:center;padding:40px 20px;color:var(--muted);">No effects yet. Click Add Effect to map a TikTok gift.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%- include('./modal-isaac-effect') %>
  <%- include('./modal-isaac-setup') %>
</div>
