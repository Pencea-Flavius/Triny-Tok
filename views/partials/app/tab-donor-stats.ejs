<div id="donorStatsContent" class="tab-content">
  <div class="page-header">
    <div>
      <h1 class="page-h1">Donor Stats</h1>
      <p class="page-sub">All-time supporters ranked by diamonds.</p>
    </div>
  </div>


  <% if (!user) { %>
  <div class="card empty-state">
    <p>Log in to see your donor stats.</p>
    <a href="/login?next=/app" class="btn-primary" style="text-decoration:none;">Sign in</a>
  </div>
  <% } else { %>

  <div class="card">
    <div id="dsDonorsList">
      <div style="text-align:center;padding:20px 0;font-size:13px;color:var(--muted);">Loading...</div>
    </div>
  </div>

  <script>
  (function() {
    const DSV = '<svg width="10" height="10" viewBox="0 0 640 640" fill="currentColor" style="vertical-align:middle;margin-right:2px;flex-shrink:0;"><path d="M232.5 136L320 229L407.5 136L232.5 136zM447.9 163.1L375.6 240L504.6 240L448 163.1zM497.9 288L142.1 288L320 484.3L497.9 288zM135.5 240L264.5 240L192.2 163.1L135.6 240zM569.8 280.1L337.8 536.1C333.3 541.1 326.8 544 320 544C313.2 544 306.8 541.1 302.2 536.1L70.2 280.1C62.5 271.6 61.9 258.9 68.7 249.7L180.7 97.7C185.2 91.6 192.4 87.9 200 87.9L440 87.9C447.6 87.9 454.8 91.5 459.3 97.7L571.3 249.7C578.1 258.9 577.4 271.6 569.8 280.1z"/></svg>';

    function esc(v) {
      return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function avatar(uid, size) {
      uid = esc(uid);
      const init = (uid || '?').charAt(0).toUpperCase();
      return `<div style="display:flex;width:${size}px;height:${size}px;border-radius:50%;background:rgba(var(--accent-rgb),0.08);border:1px solid rgba(var(--accent-rgb),0.15);align-items:center;justify-content:center;font-size:${Math.floor(size*0.4)}px;font-weight: 800;color:var(--accent);flex-shrink:0;">${init}</div>`;
    }

    let loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      fetch('/account/donors-summary')
        .then(r => r.json())
        .then(data => {
          const list = document.getElementById('dsDonorsList');
          if (!data.success || !data.donors.length) {
            list.innerHTML = '<div style="text-align:center;padding:20px 0;font-size:13px;color:var(--muted);">No donors yet. Go live to start tracking.</div>';
            return;
          }
          list.innerHTML = data.donors.map((d, i) => `
            <div class="donor-row">
              <span class="donor-rank">${i + 1}</span>
              ${avatar(d.uniqueId, 32)}
              <div class="donor-name">
                <div>@${esc(d.uniqueId)}</div>
                ${d.lastGift ? `<span>${esc(d.lastGift)}</span>` : ''}
              </div>
              <div class="donor-total">${DSV} ${d.totalDiamonds.toLocaleString()}</div>
            </div>
          `).join('');
        })
        .catch(() => {
          const list = document.getElementById('dsDonorsList');
          if (list) list.innerHTML = '<div style="text-align:center;padding:20px 0;font-size:13px;color:var(--muted);">Could not load</div>';
        });
    }

    document.addEventListener('click', e => {
      if (e.target.closest('[data-tab="donorStats"]')) load();
    });
    if (document.getElementById('donorStatsContent')?.classList.contains('active')) load();
  })();
  </script>

  <% } %>
</div>
