<div id="connectContent" class="tab-content active">
  <div class="page-header">
    <div>
      <h1 class="page-h1">Connection</h1>
      <p class="page-sub">Link TrinyTok to a live TikTok stream.</p>
    </div>
  </div>

  <div class="card">
    <label class="field-label" for="uniqueIdInput">Streamer username</label>
    <div class="connect-row">
      <input type="text" id="uniqueIdInput" placeholder="@username" value="<%= typeof tiktokUsername !== 'undefined' ? tiktokUsername : '' %>">
      <div class="connection-action-wrapper">
              <button class="btn-primary" id="connectButton">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 17H7A5 5 0 0 1 7 7H9" />
                  <path d="M15 7h2a5 5 0 0 1 0 10h-2" />
                  <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                <span>Connect</span>
              </button>
              <button class="btn-danger" id="disconnectButton" style="display:none;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 17H7A5 5 0 0 1 7 7H9" />
                  <path d="M15 7h2a5 5 0 0 1 0 10h-2" />
                  <line x1="2" y1="2" x2="22" y2="22" />
                </svg>
                <span>Disconnect</span>
              </button>
            </div>
    </div>
    <p class="field-hint">The streamer must be live on TikTok. TrinyTok then listens to gifts, chat and follows in real time.</p>
  </div>

  <div class="figures">
    <div class="figure">
      <div class="label">Viewers</div>
      <div class="figure-value" id="sessionViewers">0</div>
    </div>
    <div class="figure">
      <div class="label">Likes</div>
      <div class="figure-value" id="sessionLikes">0</div>
    </div>
    <div class="figure">
      <div class="label">Diamonds</div>
      <div class="figure-value" id="sessionDiamonds">0</div>
    </div>
    <div class="figure">
      <div class="label">Est. USD</div>
      <div class="figure-value" id="sessionUSD">$0.00</div>
    </div>
  </div>

  <div class="two-col">
    <div class="card">
      <div class="card-title">Live session</div>
      <div class="detail-row"><span>Connection status</span><b id="sessionStatus" style="color:var(--danger);">Disconnected</b></div>
      <div class="detail-row"><span>Gifts received</span><b id="sessionGifts">0</b></div>
      <div class="detail-row"><span>Chat messages</span><b id="sessionChats">0</b></div>
      <div class="detail-row"><span>Follows this session</span><b id="sessionFollows">0</b></div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title">Recent followers</div>
        <div class="field-hint" style="margin:0;"><b id="sessionFollowsBadge">0</b> this session</div>
      </div>
      <div id="recentFollowersList">
        <div class="follower-placeholder" style="text-align:center;padding:16px 0;font-size:13px;color:var(--muted);">No new followers yet</div>
      </div>
    </div>
  </div>
</div>
