<div id="topDonorsContent" class="tab-content">
  <div class="page-header">
    <div>
      <h1 class="page-h1">Top Donors</h1>
      <p class="page-sub">Session leaderboard, sorted by diamonds.</p>
    </div>
    <div class="page-actions">
      <button class="btn-secondary btn-sm" id="refreshTopDonorsBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10" />
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
        </svg>
        Refresh
      </button>
    </div>
  </div>

  <div class="figures figures-2">
    <div class="figure">
      <div class="label">Tracked diamonds</div>
      <div class="figure-value" id="totalDiamonds">0</div>
    </div>
    <div class="figure">
      <div class="label">Est. earnings (USD)</div>
      <div class="figure-value" id="totalUSD">$0.00</div>
    </div>
  </div>

  <button class="btn-secondary" id="syncInitialBtn"
    style="display:none;width:100%;border-style:dashed;justify-content:center;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round">
      <polyline points="23 4 23 10 17 10" />
      <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
    </svg>
    Sync Initial Top Donors
  </button>

  <div class="table-wrap">
    <div class="data-table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width:54px;">#</th>
            <th>User</th>
            <th>Diamonds</th>
            <th>Last gift</th>
          </tr>
        </thead>
        <tbody id="topDonorsTableBody">
          <tr>
            <td colspan="4" style="text-align:center;padding:40px 20px;color:var(--muted);">No donors yet. Connect to a live stream to start tracking.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
